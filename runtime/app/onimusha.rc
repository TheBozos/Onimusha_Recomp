// The window build's resources on Windows: its icon (Onimusha's variant of The Bozos' logo, docs/branding/make_logo.py
// oni: the clown in a kabuto under a gold crescent, four elemental katanas behind it; no game art), the UTF-8 manifest
// and its version information.
#include <winver.h>

1 ICON "onimusha.ico"
1 24 "onimusha.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Onimusha: Warlords"
            VALUE "ProductName", "Onimusha: Warlords (Onimusha_Recomp, a native PC port)"
            VALUE "InternalName", "onimusha"
            VALUE "OriginalFilename", "onimusha.exe"
            VALUE "FileVersion", "0.1.1.0"
            VALUE "ProductVersion", "0.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
